<Project Sdk="Microsoft.NET.Sdk">

  <!-- Bản dòng lệnh chạy thẳng trên Linux (không cần Wine). Giải nén bundle dùng liboo2core.so (lấy từ bản phát hành
       linux-x64 của LibGGPK3 v2.7.5, cùng phiên bản thư viện) đặt cạnh file chạy. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PoeRedux.Cli</RootNamespace>
    <AssemblyName>poeredux</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoeRedux.Core\PoeRedux.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="native/liboo2core.so" Link="liboo2core.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
